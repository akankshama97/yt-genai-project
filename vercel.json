{
  "version": 2,
  "buildCommand": "cd Fronted && npm install && npm run build",
  "outputDirectory": "Fronted/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://yt-genai-project.onrender.com/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
